---
interface Props {
  code: string;
}

const { code } = Astro.props;

function highlight(src: string): string {
  return src
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(
      /(\[(?:STEP|MAWATTE|SLIDE|EVADE|PIVOT)[^\]]*\])/g,
      '<span class="dir">$1</span>',
    )
    .replace(
      /(Stance|Beat\s*\d+)\s*:.*$/gm,
      '<span class="stance">$&</span>',
    )
    .replace(
      /(Action\s*:.*)$/gm,
      '<span class="tech">$1</span>',
    )
    .replace(
      /(Kiai\s*:.*)$/gm,
      '<span class="kiai">$1</span>',
    )
    .replace(
      /(Note|Key|Target|Bunkai|Defense(?:\s*\d+)?|Effect|Strike|Counter|Vector|Alignment|Drive)\s*:/g,
      '<span class="meta">$1</span>:',
    );
}
---

<pre class="notation" set:html={highlight(code.trim())} />
